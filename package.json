{
    "name": "@darco2903/cdn-api",
    "version": "1.4.0",
    "author": "Darco2903",
    "description": "",
    "keywords": [],
    "license": "ISC",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/Darco2903/cdn-api.git"
    },
    "homepage": "https://github.com/Darco2903/rt-stream#readme",
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./client": {
            "default": "./dist/client.js",
            "types": "./dist/client.d.ts"
        },
        "./server": {
            "default": "./dist/server.js",
            "types": "./dist/server.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "check": "tsc --noEmit",
        "prepack": "pnpm run build",
        "test": "vitest run",
        "clean": "rimraf -g dist darco2903-cdn-api-*.tgz openapi.json",
        "generate:openapi": "tsx tools/generate-openapi.ts"
    },
    "dependencies": {
        "@darco2903/auth-api": "2.1.1",
        "@ts-rest/open-api": "^3.52.1",
        "axios": "^1.12.2",
        "jsonwebtoken": "^9.0.3",
        "neverthrow": "^8.2.0",
        "socket.io-client": "^4.8.1"
    },
    "peerDependencies": {
        "@darco2903/secondthought": "^1.3.1",
