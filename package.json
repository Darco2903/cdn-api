        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@ts-rest/core": "^3.52.1",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.12.2",
        "prettier": "^3.8.1",
        "rimraf": "^6.1.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18",
        "zod": "^3.25.76"
    }
}
